# Left out of the release source archive (git archive): internal notes and tests, not needed to build.
/README.md export-ignore
/docs/ export-ignore
/tests/ export-ignore
/diagnostics/ export-ignore
/experiments/ export-ignore
/catalog/source-candidates.json export-ignore
# Corresponding inputs are supplied as authenticated .enc files. The key and
# decoding/build tools remain in the source archive; this is not access control.
/catalog/games.json export-ignore
/catalog/releases.json export-ignore
/catalog/catalog.json export-ignore
/catalog/addons.json export-ignore
/catalog/addons-catalog.json export-ignore
# Preserve upstream licence text byte for byte, including its original line endings.
/licenses/ps5-opengl/** -whitespace

# Internal release evidence is not part of the corresponding build sources.
/release-status.json export-ignore

# Internal agent instructions are not distributed with public source bundles.
/AGENTS.md export-ignore
